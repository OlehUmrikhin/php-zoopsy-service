# App
APP_ENV=development
APP_DEBUG=true
APP_KEY=base64:REPLACE_WITH_RANDOM_KEY
# Service port (used локально / Procfile)
PORT=8080
APP_HOST=0.0.0.0
API_KEY=change-me-in-prod
ADMIN_API_KEY=change-admin-key

DB_PATH=./data/database.sqlite

SESSION_LIFETIME=86400          # seconds (24h)
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax     # Lax | Strict | None

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://zoopsy-fe.vercel.app
# Rate limiting (optional)
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=info

# Optional: trusted proxies (comma-separated)
TRUSTED_PROXIES=